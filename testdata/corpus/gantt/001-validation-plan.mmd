%% Tytuł: Plan walidacji procesu
%% Sprawdza: sekcje, zadania z datą i czasem trwania, zależności after, stany done, active i crit, kamień milowy, nazwy dłuższe niż pasek, tytuł.
gantt
    title Walidacja procesu sterylizacji
    dateFormat YYYY-MM-DD
    section Przygotowanie
    Plan walidacji               :done, plan, 2026-01-05, 10d
