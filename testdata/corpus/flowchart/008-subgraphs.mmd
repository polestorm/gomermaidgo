%% REQ: FLOW-007
%% Tytuł: Podgrafy
%% Sprawdza: Podgraf z tytułem, zagnieżdżony, z tytułem ze spacjami; krawędź do ramki, z ramki i przez ramkę.
flowchart TB
    Start --> Rejestracja
    subgraph Nadzór["Nadzór pełnomocnika ds. jakości"]
        direction LR
        Plan[Plan działań] --> Wdrożenie[/Wdrożenie/]
        subgraph Weryfikacja
            Ocena{Ocena skuteczności}
        end
        Wdrożenie --> Ocena
    end
    subgraph Zamknięcie i archiwizacja
        Archiwum[(Archiwum)]
    end
    Rejestracja --> Nadzór
    Ocena -->|skuteczne| Archiwum
    Weryfikacja -.-> Start
