%% REQ: VENN-001 VENN-002 VENN-003 VENN-004
%% Tytuł: Zbiór osobny i wypełnienie części wspólnej
%% Sprawdza: trzy zbiory, z których jeden nie ma części wspólnej z pozostałymi (stoi osobno), nazwy w cudzysłowie, styl części wspólnej (fill, fill-opacity, color), styl obrysu zbioru, accTitle, komentarz.
venn-beta
  accTitle: Wyroby i ich dokumentacja
  %% zbiór Archiwum nie ma części wspólnej
  set "Wyroby seryjne"
  set Prototypy
  set Archiwum["Archiwum zamknięte"]
  union "Wyroby seryjne",Prototypy["Wyroby po zmianie"]
  style "Wyroby seryjne",Prototypy fill:#9aa5b1,fill-opacity:0.6,color:#1b1f24
  style Archiwum stroke:#9aa5b1,stroke-width:3
